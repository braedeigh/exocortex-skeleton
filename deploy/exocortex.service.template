# Origin: personal vault deploy/exocortex.service. Scrubbed modular copy — plug-in points marked PLUG-IN(...)
[Unit]
Description=Exocortex Dashboard
After=network.target

[Service]
User=<APP_USER>
Group=<APP_USER>
WorkingDirectory=<SKELETON_DIR>
# --max-requests recycles a worker after N requests, as a memory-leak guard.
# It is also a turn-killer: an agent turn's relay lives inside the worker, so
# a recycle mid-turn strands the reply half-written and leaves `running: true`
# set forever. At 1000, against a roster that polls every few seconds, that
# fired roughly hourly during ordinary use. 10000 keeps the leak guard and
# makes the collision rare. The real fix is hosting turns outside gunicorn;
# this is the cheap part of it.
ExecStart=<SKELETON_DIR>/venv/bin/gunicorn -k gevent -w 2 --worker-connections 1000 --timeout 120 --max-requests 10000 --max-requests-jitter 1000 -b 127.0.0.1:5000 server:app
Environment=TEMPLATES_AUTO_RELOAD=1
Environment=EXOCORTEX_DATA_DIR=<VAULT_DIR>/data
Environment=EXOCORTEX_CONTENT_DIR=<VAULT_DIR>/tulku
Environment=EXOCORTEX_RECEIPTS_DIR=<VAULT_DIR>/receipts
Environment=EXOCORTEX_RECIPES_DIR=<VAULT_DIR>/recipes
Environment=EXOCORTEX_IDEAS_FILE=<VAULT_DIR>/docs/IDEAS.md
# PLUG-IN(OWNER_NAME): display name shown in the app header/footer.
Environment="EXOCORTEX_OWNER_NAME=<OWNER_NAME>"
Environment=EXOCORTEX_APP_NAME=Exocortex
# PLUG-IN(PUBLIC_ONLY): uncomment on a read-only public mirror (a portfolio copy
# on a public host). Every request is served in the frosted "public" view no
# matter what cookie it carries, and /login answers 404 — see config.public_only.
#Environment=EXOCORTEX_PUBLIC_ONLY=1
Restart=always

[Install]
WantedBy=multi-user.target
