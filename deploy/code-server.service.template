# Origin: personal vault deploy/code-server.service. Scrubbed modular copy — plug-in points marked PLUG-IN(...)
[Unit]
Description=code-server — VS Code in the browser
After=network.target

[Service]
Type=simple
User=<APP_USER>
ExecStart=/usr/bin/code-server --open <SKELETON_DIR>
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
