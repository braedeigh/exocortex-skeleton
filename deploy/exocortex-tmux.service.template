# Origin: personal vault deploy/exocortex-tmux.service. Scrubbed modular copy — plug-in points marked PLUG-IN(...)
[Unit]
# Owns the tmux server that backs the web terminal (ttyd attaches to it).
# Kept SEPARATE from ttyd.service on purpose: if it lived in ttyd's cgroup,
# restarting ttyd would kill the tmux server and every running session. This
# service owns the server in its own cgroup, so ttyd can be restarted freely.
Description=Exocortex tmux session server
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=<APP_USER>
Group=<APP_USER>
# PLUG-IN(TMUX_SOCKET): pick any path your app user can write to. Every other
# unit/script that talks to this tmux server (ttyd.service, keeper_rollover.sh,
# ttyd_connect.sh) must use the SAME socket path.
ExecStartPre=/bin/sh -c 'mkdir -p "$(dirname <TMUX_SOCKET>)"'
ExecStart=/usr/bin/tmux -S <TMUX_SOCKET> new-session -d -s chat -c <SKELETON_DIR>
ExecStartPost=-/usr/bin/tmux -S <TMUX_SOCKET> new-session -d -s cleanup -c <SKELETON_DIR>
ExecStop=/usr/bin/tmux -S <TMUX_SOCKET> kill-server

[Install]
WantedBy=multi-user.target
