# Origin: personal vault deploy/flask-proxy-secret.conf. Scrubbed modular copy — plug-in points marked PLUG-IN(...)
# Drop-in for exocortex.service (Flask/gunicorn): tells Flask where the
# proxy-trust HMAC secret lives. Only needed if you run the optional Rust
# front server with real multi-user auth — see deploy/phase1-cutover.md.
# Install:
#   sudo mkdir -p /etc/systemd/system/exocortex.service.d
#   sudo cp <this file, rendered> /etc/systemd/system/exocortex.service.d/proxy-secret.conf
#   sudo systemctl daemon-reload && sudo systemctl restart exocortex.service
[Service]
Environment=EXO_PROXY_SECRET_FILE=<SRV_DIR>/proxy_secret
