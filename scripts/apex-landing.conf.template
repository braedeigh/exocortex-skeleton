# Origin: personal vault scripts/ (an apex-landing nginx config whose original
# filename baked in the real apex domain — renamed here to avoid carrying that
# domain into a shareable filename). Scrubbed modular copy — plug-in points
# marked PLUG-IN(...)
# Apex landing page.
# - Only proxies "/" to the app (useful if you serve a distinct landing page
#   when Host matches the bare apex domain, separate from the app's usual
#   <APP_DOMAIN> vhost).
# - Everything else returns 404 — keeps the apex purely for the landing.
# - certbot --nginx will add the SSL block automatically when run.
#
# PLUG-IN(APP_DOMAIN): the bare/apex form of your domain (e.g. example.com,
# without the app's usual subdomain).

server {
    listen 80;
    server_name <APP_DOMAIN> www.<APP_DOMAIN>;

    client_max_body_size 1m;

    # Only the landing path proxies to Flask.
    location = / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Don't expose any other Flask routes on the apex.
    location / {
        return 404;
    }
}
