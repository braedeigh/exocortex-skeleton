      "Edit(//srv/mailclaude/data/sent/**)",
      "Edit(//srv/mailclaude/data/failed/**)",
      "Edit(//srv/mailclaude/clerk/**)",
      "Edit(//srv/mailclaude/corpus/**)",
      "Edit(//home/**)",
      "Edit(//tmp/**)",
      "Edit(//var/tmp/**)",
      "Edit(//dev/shm/**)"
