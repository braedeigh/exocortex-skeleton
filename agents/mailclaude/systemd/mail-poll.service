# Origin: personal vault mailclaude/systemd/mail-poll.service. Scrubbed
# modular copy — plug-in points marked PLUG-IN(...)
#
# PLUG-IN(SRV_DIR): ExecStart below assumes the default install dir
# /srv/mailclaude. If you relocated the tree, update the path to match.
[Unit]
Description=mail-claude: poll the site mailbox into data/inbox/

[Service]
Type=oneshot
User=mailer
Group=mailroom
ExecStart=/srv/mailclaude/bin/poll-mail.py
