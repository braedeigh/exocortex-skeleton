{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expenses",
  "type": "object",
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "date", "amount"],
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "comments": { "type": "string" },
        "title": { "type": "string" },
        "receipt": { "type": "string" },
        "source": { "type": "string" },
        "bank_matched": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "additionalProperties": true
}
