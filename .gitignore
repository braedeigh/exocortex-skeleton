# Personal data + secrets never belong in the shareable repo
data/*
!data/.gitkeep
uploads/
*.log
*.log.*
auth.json
sessions.json
.env

# Release tarballs (built by scripts/make-release.sh)
release/

# Local Claude Code config (hook wiring written by install.sh) — machine-local,
# never shared or committed. (.claude/commands/ IS committed: project-level
# slash commands, so /journalstart works right after a pull.)
.claude/settings.json
.claude/settings.local.json

# Python
__pycache__/
*.pyc
venv/
.pytest_cache/

# Rust (tools/)
target/
CLAUDE.local.md
node_modules/
.venv/
