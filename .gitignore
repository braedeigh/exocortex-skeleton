# Personal data + secrets never belong in the shareable repo
data/*
!data/.gitkeep
uploads/
*.log
*.log.*
auth.json
sessions.json
.env

# Release tarballs (built by scripts/make-release.sh)
release/

# Local Claude Code config (hook wiring written by install.sh) — machine-local,
# never shared or committed. (.claude/commands/ IS committed: project-level
# slash commands, so /journalstart works right after a pull.)
.claude/settings.json
.claude/settings.local.json

# Python
__pycache__/
*.pyc
# Both spellings on purpose. A trailing slash matches DIRECTORIES only, and an
# unattended session's worktree (worktrees.py) gets its venv as a SYMLINK to the
# main checkout's — which git sees as a file, so `venv/` alone would leave it
# untracked-but-visible and one `git add -A` away from being committed.
venv/
venv
.pytest_cache/

# Rust (tools/)
target/
CLAUDE.local.md
node_modules/
.venv/

# Night crew's transient Playwright helper (tools/nightcrew/shots.py) — written
# into a worktree's frontend/ during screenshots, unlinked in a finally; the
# ignore is belt-and-braces so a crashed run can't leave a dirty tree.
.nightcrew-shot.cjs

# pytest-testmon's map of which test runs which code (see requirements-dev.txt)
.testmondata*
